def find_db():
    """Return the database path according to the lookup order."""
    env = os.environ.get("FOAMFV_DB")
    if env:
        if not Path(env).is_file():
            sys.exit(f"Error: FOAMFV_DB={env} not found.")
        return Path(env)
    ver = current_version()
    if ver and user_db_path(ver).is_file():
        return user_db_path(ver)
    return BUNDLED_DB


def load_db():
    path = find_db()
    if not path.is_file():
        sys.exit("Error: database not found. Run 'foamFV build' first.")
    db = json.loads(path.read_text(encoding="utf-8"))
    ver = current_version()
    if ver and path == BUNDLED_DB and db.get("version") != ver and not os.environ.get("FOAMFV_QUIET"):
        print(f"Warning: bundled database is for {db.get('version')}, but the "
              f"environment is {ver}. Run 'foamFV build' for an exact match.",
              file=sys.stderr)
    return db


def use_color():
    return sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def c(text, code):
    return f"\033[{code}m{text}\033[0m" if use_color() else text


def lookup(db, name):
    """Return (entry, selected type name). Accepts class or variant names."""
    fvs = db["fvOptions"]
    if name in fvs:
        e = fvs[name]
        return e, (e["variants"][0] if e["template"] else e["name"])
    low = name.lower()
    for k, e in fvs.items():
        if k.lower() == low:
            return e, (e["variants"][0] if e["template"] else e["name"])
        for v in e["variants"]:
            if v.lower() == low:
                return e, v
        if e["display"].lower() == low:
            return e, e["variants"][0]
    close = [e["display"] for k, e in fvs.items()
             if low in k.lower() or any(low in v.lower() for v in e["variants"])]
    msg = f"Error: unknown fvOption '{name}'."
    if close:
        msg += " Did you mean: " + ", ".join(close[:10]) + " ?"
    sys.exit(msg)


def print_rows(entries):
    w = max([len(e["display"]) for e in entries] + [4])
    for e in entries:
        flag = "T" if e["tutorials"] else " "
        flag += "Z" if e["cellSet"] else ("R" if e["interRegion"] else " ")
        s = e["summary"]
        if len(s) > 78:
            s = s[:75] + "..."
        print(f"{c(e['display'].ljust(w), '1;36')}  {flag}  {e['group']:<14} {s}")


def legend():
    return ("T: used in tutorials, Z: cell selection (selectionMode), "
            "R: inter-region option")


def cmd_list(args):
    db = load_db()
    es = list(db["fvOptions"].values())
    if args.group:
        es = [e for e in es if args.group.lower() in e["group"].lower()]
    if args.groups:
        cnt = {}
        for e in es:
            cnt[e["group"]] = cnt.get(e["group"], 0) + 1
        for g, n in sorted(cnt.items()):
            print(f"{g:<16}{n}")
        return
    print_rows(es)
    print(f"\n{len(es)} entries  ({legend()})")


def cmd_search(args):
    db = load_db()
    words = [w.lower() for w in args.keywords]
    hits = []
    for e in db["fvOptions"].values():
        names = " ".join([e["name"], e["display"]] + e["variants"]).lower()
        hay = " ".join([names, e["description"], e["header"], e.get("aliases", ""),
                        " ".join(r["name"] for t in e["tables"] for r in t["rows"])]).lower()
        if all(w in hay for w in words):
            score = sum(3 for w in words if w in names) + \
                sum(1 for w in words if w in e["summary"].lower()) + \
                sum(2 for w in words if w in e.get("aliases", "").lower()) + \
                (1 if e["tutorials"] else 0)
            hits.append((-score, e["name"].lower(), e))
    if not hits:
        print("No match. Try English keywords or 'foamFV list'.")
        return
    print_rows([h[2] for h in sorted(hits)])


def format_tables(tables, only_required=False):
    out = []
    for t in tables:
        rows = [r for r in t["rows"] if not only_required or r["reqd"] == "yes"]
        if not rows:
            continue
        if t["heading"]:
            out.append(c(f"  [{t['heading']}]", "1"))
        wn = max(len(r["name"]) for r in rows)
        wt = max([len(r["type"]) for r in rows] + [4])
        out.append(f"  {'Property'.ljust(wn)}  {'Type'.ljust(wt)}  Reqd  Default        Description")
        for r in rows:
            name = r["name"].ljust(wn)
            if r["reqd"] == "yes":
                name = c(name, "1;31")
            elif r["reqd"] == "cond":
                name = c(name, "1;35")
            out.append(f"  {name}  {r['type'].ljust(wt)}  {r['reqd'][:4]:<4}  "
                       f"{(r['default'] or '-')[:13]:<13}  {r['desc']}")
    return "\n".join(out)


