def build_entry(e, type_name, entry_name, mode, bases=None, fallback=None):
    """Create a dictionary entry text from the header example."""
    curated = CURATED.get(e["class"]) or CURATED.get(e["name"])
    if curated:
        text = curated.replace("{TYPE}", type_name).replace("{NAME}", entry_name)
        return finish_entry(e, text, mode, bases)
    ex = e["example"]
    if (not ex or not TYPE_ENTRY_RE.search(ex)) and fallback:
        lines = fallback.splitlines()
        lines[0] = entry_name
        text = "\n".join(lines)
        text = re.sub(r"^(\s*type\s+)[\w:.]+", r"\g<1>" + type_name, text, count=1, flags=re.M)
        return finish_entry(e, text, mode, bases)
    if not ex or not TYPE_ENTRY_RE.search(ex):
        ex = "{0}\n{{\n    type            {1};\n}}".format(entry_name, type_name)
    # Resolve the templated type name
    ex = re.sub(r"\\?<Type\\?>" + re.escape(e["class"]), type_name, ex)
    lines = ex.splitlines()
    # Rename the top-level dictionary
    for i, l in enumerate(lines):
        if l.strip() and not l.strip().startswith("//"):
            if re.match(r"^[\w<>.\-]+\s*$", l.strip()):
                lines[i] = entry_name
            break
    # Make sure the type entry carries the selected type
    for i, l in enumerate(lines):
        m = TYPE_ENTRY_RE.match(l)
        if m:
            lines[i] = l.replace(m.group(1), type_name, 1)
            break
    required = {r["name"] for t in e["tables"] for r in t["rows"] if r["reqd"] == "yes"}
    # Locate the outer braces of the top-level dictionary
    first = next((i for i, l in enumerate(lines) if l.strip() == "{"), None)
    last = max((i for i, l in enumerate(lines) if l.strip() == "}"), default=None)
    has_markers = any(l.strip().startswith("//") and "mandatory" in l.lower() for l in lines)
    out = []
    section = "mandatory"
    depth = 0
    for i, l in enumerate(lines):
        s = l.strip()
        low = s.lower()
        if depth <= 1 and low.startswith("//"):
            if "conditional" in low:
                section = "conditional"
            elif "optional" in low:
                section = "optional"
            elif "inherited" in low:
                section = "inherited"
            elif "mandatory" in low:
                section = "mandatory"
            elif re.match(r"//\s*(option\b|option-|or\b)", low):
                section = "conditional"
        nopen = s.count("{") - s.count("}") if not s.startswith("//") else 0
        if s in ("...", "// ..."):
            depth += nopen
            continue
        key = re.match(r"^([\w\-]+)\s", s + " ")
        is_req = depth == 1 and bool(key) and key.group(1) in required and ";" in s
        outer = first is None or i <= first or i == last
        # Without section markers, treat nested dictionaries as optional
        nested = False
        if not has_markers and not outer:
            nxt = next((x.strip() for x in lines[i + 1:] if x.strip()), "")
            nested = depth >= 2 or nopen > 0 or \
                (depth == 1 and re.match(r"^[\w<>\-]+$", s) is not None and nxt.startswith("{"))
        if outer or (section == "mandatory" and not nested) or is_req:
            out.append(l)
        elif mode == "full":
            if s and not s.startswith("//"):
                out.append(re.sub(r"^(\s*)", r"\1// ", l, count=1))
            else:
                out.append(l)
        depth += nopen
    # Drop dangling comment headers / blank runs
    clean = []
    for l in out:
        if not l.strip() and clean and not clean[-1].strip():
            continue
        clean.append(l)
    if mode != "full":
        clean = [l for j, l in enumerate(clean)
                 if not (l.strip().startswith("//") and
                         (j + 1 >= len(clean) or not clean[j + 1].strip()
                          or clean[j + 1].strip() == "}"))]
    out = [l for j, l in enumerate(clean)
           if not (not l.strip() and j + 1 < len(clean) and clean[j + 1].strip() == "}")]
    return finish_entry(e, "\n".join(out), mode, bases)


def mandatory_lines(example):
    """Return mandatory one-line entries at depth 1 of a base-class example."""
    out = []
    section = "mandatory"
    depth = 0
    for l in example.splitlines():
        s = l.strip()
        low = s.lower()
        if depth == 1 and low.startswith("//"):
            if "optional" in low or "conditional" in low:
                section = "optional"
            elif "inherited" in low or "derived" in low:
                section = "other"
            elif "mandatory" in low:
                section = "mandatory"
        elif depth == 1 and section == "mandatory" and re.match(r"^\w+\s+[^{]*;", s) \
                and not s.startswith("type"):
            out.append(s)
        depth += s.count("{") - s.count("}") if not s.startswith("//") else 0
    return out


def finish_entry(e, text, mode, bases=None):
    """Add base-class entries, libs and (full mode) the documented extras."""
    live = strip_comments(text)
    type_re0 = re.compile(r"(^\s*type\s+[\w:.]+\s*;[^\n]*\n)", re.M)
    for b in e["inherited"]:
        if b in ("fvOption.H", "cellSetOption.H") or not bases or b not in bases:
            continue
        add = [l for l in mandatory_lines(bases[b].get("example", ""))
               if not re.search(r"^\s*" + re.escape(l.split()[0]) + r"\s", live, re.M)]
        if add:
            block = f"\n    // Mandatory entries from {b}\n" + \
                "".join(f"    {l}\n" for l in add)
            text = type_re0.sub(lambda m: m.group(1) + block, text, count=1)
            live = strip_comments(text)
    type_re = re.compile(r"(^\s*type\s+[\w:.]+\s*;[^\n]*\n)", re.M)
    # Cell selection (cellSetOption) is mandatory but usually only "inherited"
    if e["cellSet"] and not re.search(r"^\s*selectionMode\s", live, re.M):
        text = type_re.sub(
            r"\1\n    // Cell selection (cellSetOption.H)\n"
            r"    selectionMode   cellZone;        // all | cellZone | cellSet | points | geometric\n"
            r"    cellZone        <cellZoneName>;\n", text, count=1)
    # Ensure the libs entry exists
    if e["libs"] and not LIBS_RE.search(text):
        text = type_re.sub(r"\1    libs            (" + " ".join(e["libs"]) + ");\n",
                           text, count=1)
    if mode == "full":
        # Document parameters missing from the example
        present = set(re.findall(r"^\s*(?://\s*)?(\w+)\s", text, re.M))
        extra = [r for t in e["tables"] for r in t["rows"]
                 if r["name"] not in present and re.match(r"^\w+$", r["name"])]
        if extra:
            add = ["", "    // Further entries documented in the header:"]
            for r in extra:
                d = f" (default: {r['default']})" if r["default"] else ""
                add.append(f"    // {r['name']:<16} <{r['type'] or 'value'}>;  "
                           f"// {r['desc']}{d}")
            idx = text.rfind("}")
            text = text[:idx].rstrip("\n") + "\n" + "\n".join(add) + "\n" + text[idx:]
        common = "active, log"
        if e["cellSet"]:
            common += ", selectionMode, cellZone(s), cellSet, points, timeStart, duration"
        text += f"\n\n// Common entries ({', '.join(e['inherited']) or 'fvOption.H'}): {common}"
    return text


def apply_case_values(text, zone=None, fields=None):
    """Fill selection/field entries given on the command line."""
    if zone:
        if zone == "all":
            text = re.sub(r"^(\s*selectionMode\s+)[^;]*;[^\n]*", r"\1all;", text, count=1, flags=re.M)
            text = re.sub(r"^\s*cellZone\s+<[^>]*>;[^\n]*\n", "", text, flags=re.M)
        else:
            text = re.sub(r"^(\s*selectionMode\s+)[^;]*;[^\n]*", r"\1cellZone;", text,
                          count=1, flags=re.M)
            text = re.sub(r"^(\s*cellZone\s+)[^;]*;", r"\g<1>" + zone + ";", text,
                          count=1, flags=re.M)
    if fields:
        fl = fields.replace(",", " ").split()
        text = re.sub(r"^(\s*fields\s+)[^;]*;", r"\g<1>(" + " ".join(fl) + ");", text,
                      count=1, flags=re.M)
        text = re.sub(r"^(\s*field\s+)[^;]*;", r"\g<1>" + fl[0] + ";", text,
                      count=1, flags=re.M)
        if len(fl) == 1:
            text = text.replace("<fieldName>", fl[0])
    return text


def case_info(case, region=None):
    """Return (cellZones, fields) found in the case (best effort)."""
    mesh = case / "constant" / (region or "") / "polyMesh"
    zones = []
    for fn in ("cellZones", "cellZones.gz"):
        p = mesh / fn
        if p.is_file():
            txt = read_text(p)
            # Header meta data written by recent versions: names N ( a b );
            m = re.search(r"^\s*names\s+\d*\s*\(([^)]*)\)", txt[:4000], re.M)
            if m:
                zones = m.group(1).split()
            else:
                zones = re.findall(r"^\(?(\w+)\s*\n\s*\{\s*\n\s*type\s+cellZone\s*;",
                                   txt, re.M)
            break
    fields = []
    for t in ("0", "0.orig"):
        d = case / t / (region or "")
        if d.is_dir():
            fields = sorted(p.name.replace(".gz", "") for p in d.iterdir()
                            if p.is_file() and not p.name.startswith(".")
                            and not p.name.endswith((".orig", ".bak")))
            break
    return zones, fields


def foam_header(location):
    return (
        "/*--------------------------------*- C++ -*----------------------------------*\\\n"
        "  =========                 |\n"
        "  \\\\      /  F ield         | OpenFOAM: The Open Source CFD Toolbox\n"
        "   \\\\    /   O peration     |\n"
        "    \\\\  /    A nd           | www.openfoam.com\n"
        "     \\\\/     M anipulation  |\n"
        "\\*---------------------------------------------------------------------------*/\n"
        "FoamFile\n{\n"
        "    version     2.0;\n"
        "    format      ascii;\n"
        "    class       dictionary;\n"
        f"    location    \"{location}\";\n"
        "    object      fvOptions;\n"
        "}\n"
        "// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //\n\n")


FOAM_FOOTER = "\n// ************************************************************************* //\n"


def insert_entry(target, location, entry_name, body):
    """Append an entry to an fvOptions file (create it if needed)."""
    if not target.exists():
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(foam_header(location) + body + "\n" + FOAM_FOOTER, encoding="utf-8")
        print(f"Created {target}")
        return True
    text = read_text(target)
    if re.search(r"^" + re.escape(entry_name) + r"\s*(\{|$)", strip_comments(text), re.M):
        print(f"Error: entry '{entry_name}' already exists in {target} (use -n)",
              file=sys.stderr)
        return False
    bak = target.with_name(target.name + ".bak")
    if not bak.exists():  # keep the oldest (original) backup
        shutil.copy2(target, bak)
    lines = text.rstrip("\n").splitlines()
    tail = None
    for i in range(len(lines) - 1, -1, -1):
        if lines[i].startswith("// *****"):
            tail = i
            break
    new = body.rstrip("\n").splitlines() + [""]
    if tail is None:
        lines += [""] + new
    else:
        # Remove the blank lines before the footer, then insert
        while tail > 0 and not lines[tail - 1].strip():
            del lines[tail - 1]
            tail -= 1
        lines[tail:tail] = [""] + new + [""]
    target.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"Appended '{entry_name}' to {target} (backup: {bak.name})")
    return True


def tutorial_block(e, type_name):
    """Return (block text, path) of the first tutorial entry using the type."""
    root = project_dir(None, required=False)
    if root is None:
        return None, None
    names = [type_name] + [n for n in (e["variants"] or [e["name"]]) if n != type_name]
    for want in names:
        for rel in e["tutorials"]:
            text = read_text(root / rel)
            lines = text.splitlines()
            for i, t in top_level_types(text):
                if t == want:
                    blk = find_brace_block(lines, i)
                    if blk:
                        return dedent("\n".join(lines[blk[0]: blk[1] + 1])), rel
    return None, None


def cmd_add(args):
    db = load_db()
    e, type_name = lookup(db, args.name)
    if e["template"] and args.name not in e["variants"]:
        print(f"Note: '{args.name}' is templated; using '{type_name}' "
              f"(other types: {', '.join(e['variants'][1:])})", file=sys.stderr)
    case = Path(args.case).resolve()
    entry_name = args.entry or type_name + "1"
    fallback = None
    src_note = e["header"]
    if (not e["example"] or not TYPE_ENTRY_RE.search(e["example"])) and e["tutorials"]:
        fallback, rel = tutorial_block(e, type_name)
        if fallback:
            src_note = f"tutorial {rel} (no usable example in {e['header']}; adjust the values)"
    text = build_entry(e, type_name, entry_name, "full" if args.full else "minimal",
                       db.get("bases"), fallback)
    text = apply_case_values(text, args.zone, args.fields)
    stamp = date.today().isoformat()
    body = f"// Generated by foamFV from {src_note} ({stamp})\n{text}\n"
    placeholders = sorted(set(re.findall(r"<[\w ,:/|.\-]+>", strip_comments(text))))

    location = "system" if args.system else "constant"
    target = case / location / (args.region or "") / "fvOptions"
    if args.stdout or not args.insert:
        print(body)
        if not args.stdout:
            print(f"// (use --insert to append it to {target})", file=sys.stderr)
    else:
        if not (case / "constant").is_dir() and not (case / "system").is_dir():
            sys.exit(f"Error: {case} does not look like a case directory (use -case)")
        if not insert_entry(target, location + (f"/{args.region}" if args.region else ""),
                            entry_name, body):
            sys.exit(1)
        # fv::options reads constant/fvOptions and falls back to
        # system/fvOptions only when the former does not exist
        other = case / ("constant" if args.system else "system") / (args.region or "") / "fvOptions"
        if other.exists():
            ignored = target if args.system else other
            print(c(f"Warning: both constant/ and system/ fvOptions exist; only "
                    f"constant/fvOptions is read, {ignored} is ignored.", "1;31"),
                  file=sys.stderr)

    # Hints from the case
    if (case / "constant").is_dir():
        zones, fields = case_info(case, args.region)
        if e["cellSet"] and not args.zone:
            print("cellZones in mesh: " + (" ".join(zones) if zones else
                  "(none found: create them with topoSet/setsToZones, or use --zone all)"),
                  file=sys.stderr)
        elif args.zone and args.zone != "all" and zones and args.zone not in zones:
            print(c(f"Warning: cellZone '{args.zone}' not found in the mesh "
                    f"({' '.join(zones)})", "1;31"), file=sys.stderr)
        if fields and re.search(r"^\s*fields?\s", strip_comments(text), re.M) and not args.fields:
            print("fields in 0/: " + " ".join(fields), file=sys.stderr)
    if placeholders:
        print(c("Edit these placeholders before running: ", "1;31") + " ".join(placeholders),
              file=sys.stderr)


