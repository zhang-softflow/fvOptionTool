def cmd_html(args):
    db = load_db()
    if not HTML_TEMPLATE.is_file():
        sys.exit(f"Error: template {HTML_TEMPLATE} not found")
    # Pre-generate the ready-to-edit entries shown in the catalog
    for e in db["fvOptions"].values():
        tname = e["variants"][0] if e["template"] else e["name"]
        fallback = None
        if (not e["example"] or not TYPE_ENTRY_RE.search(e["example"])) and e["tutorials"]:
            fallback, _ = tutorial_block(e, tname)
        e["entry"] = build_entry(e, tname, tname + "1", "minimal", db.get("bases"), fallback)
    data = json.dumps(db, ensure_ascii=False).replace("</", "<\\/")
    page = read_text(HTML_TEMPLATE).replace("/*__FV_DATA__*/null", data)
    out = Path(args.output) if args.output else HTML_FILE
    out.write_text(page, encoding="utf-8")
    print(f"Wrote {out}")


