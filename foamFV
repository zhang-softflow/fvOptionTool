MAKEFV_RE = re.compile(r"^\s*makeFvOption\s*\(\s*(\w+)\s*,\s*(\w+)\s*\)", re.M)
TYPE_ENTRY_RE = re.compile(r"^\s*type\s+([\w:.<>]+)\s*;", re.M)
LIBS_RE = re.compile(r"^\s*libs\s*\(([^)]*)\)\s*;", re.M)
LINK_RE = re.compile(r"\\link\s+([\w.]+)\s+\\endlink")
BASECLASS_RE = re.compile(
    r"public\s+(?:Foam::)?(?:fv::)?(cellSetOption|interRegionOption|"
    r"interRegionHeatTransferModel|option)\b")


