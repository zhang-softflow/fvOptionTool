def main():
    p = argparse.ArgumentParser(prog="foamFV", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("build", help="scan OpenFOAM sources and build the database")
    s.add_argument("--src", help="OpenFOAM source root (default: $WM_PROJECT_DIR)")
    s.add_argument("-o", "--output",
                   help="database file (default: ~/.local/share/foamFV/fvDatabase-<version>.json)")
    s.add_argument("-v", "--verbose", action="store_true")
    s.set_defaults(func=cmd_build)

    s = sub.add_parser("list", help="list fvOptions")
    s.add_argument("-g", "--group",
                   help="filter by group (sources, general, constraints, corrections, ...)")
    s.add_argument("--groups", action="store_true", help="list groups with counts")
    s.set_defaults(func=cmd_list)

    s = sub.add_parser("search", help="search names/descriptions (all keywords must match)")
    s.add_argument("keywords", nargs="+")
    s.set_defaults(func=cmd_search)

    s = sub.add_parser("show", help="show documentation of an fvOption")
    s.add_argument("name")
    s.add_argument("-i", "--inherited", action="store_true", help="also show inherited entries")
    s.add_argument("--more", action="store_true", help="show additional header examples")
    s.add_argument("-m", "--max", type=int, default=8, help="max tutorial paths to list")
    s.set_defaults(func=cmd_show)

    s = sub.add_parser("example", help="print usage blocks taken from the tutorials")
    s.add_argument("name")
    s.add_argument("-m", "--max", type=int, default=3)
    s.add_argument("--src", help="OpenFOAM source root (default: $WM_PROJECT_DIR)")
    s.set_defaults(func=cmd_example)

    s = sub.add_parser("add", help="generate an entry (print, or append to fvOptions with --insert)")
    s.add_argument("name", help="type name, e.g. scalarSemiImplicitSource or limitTemperature")
    s.add_argument("-case", "--case", default=".", help="case directory (default: cwd)")
    s.add_argument("-n", "--entry", help="entry name (default: <type>1)")
    s.add_argument("-z", "--zone", help="cellZone name to select ('all' for selectionMode all)")
    s.add_argument("--fields", help="field name(s) for 'fields'/'field', e.g. 'T' or 'U,k'")
    s.add_argument("-region", "--region", help="region name (multi-region cases)")
    s.add_argument("--system", action="store_true",
                   help="use system/fvOptions instead of constant/fvOptions")
    g = s.add_mutually_exclusive_group()
    g.add_argument("--minimal", action="store_true", help="mandatory entries only (default)")
    g.add_argument("--full", action="store_true", help="also list optional entries as comments")
    s.add_argument("--insert", action="store_true",
                   help="append to <case>/constant/fvOptions (created if missing, backup .bak)")
    s.add_argument("--stdout", action="store_true", help="only print (default without --insert)")
    s.set_defaults(func=cmd_add)

    s = sub.add_parser("html", help="generate catalog.html")
    s.add_argument("-o", "--output")
    s.set_defaults(func=cmd_html)

    args = p.parse_args()
    try:
        args.func(args)
    except BrokenPipeError:
        pass


if __name__ == "__main__":
    main()
