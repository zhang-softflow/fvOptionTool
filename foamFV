def parse_header(hpath):
    text = read_text(hpath)
    comment = header_comment(text)
    secs = split_sections(comment)
    usage = secs.get("Usage", "")
    desc_raw = secs.get("Description", "")
    verbs = extract_verbatims(usage) + extract_verbatims(desc_raw)
    tables = parse_tables(usage) + parse_tables(desc_raw)
    verbs = [v.replace("\\<", "<").replace("\\>", ">") for v in verbs]
    # Fallback: documentation in the .C/.cxx file
    if not verbs or not tables:
        for ext in (".C", ".cxx"):
            src = Path(hpath).with_suffix(ext)
            if src.is_file():
                s2 = split_sections(header_comment(read_text(src)))
                for key in ("Usage", "Description"):
                    if not verbs:
                        verbs = [v.replace("\\<", "<").replace("\\>", ">")
                                 for v in extract_verbatims(s2.get(key, ""))]
                    if not tables:
                        tables = parse_tables(s2.get(key, ""))
    inherited = [i for i in dict.fromkeys(LINK_RE.findall(usage + desc_raw))
                 if i.endswith(".H") and i != Path(hpath).name]
    return {
        "text": text,
        "description": clean_doxygen(desc_raw),
        "verbatims": verbs,
        "tables": tables,
        "inherited": inherited,
        "seeAlso": clean_doxygen(secs.get("See also", "")),
        "note": clean_doxygen(secs.get("Note", "")),
    }


def pick_example(verbs, tnames):
    """Choose the verbatim block that is a usage example of one of 'tnames'."""
    for t in tnames:
        pat = re.compile(r"^\s*type\s+(?:\\?<Type\\?>)?" + re.escape(t) + r"\s*;", re.M)
        for v in verbs:
            if pat.search(v):
                return v
    for v in verbs:
        if TYPE_ENTRY_RE.search(v) and "{" in v:
            return v
    for v in verbs:
        if "{" in v:
            return v
    return ""


def guess_group(rel):
    for prefix, g in GROUP_RULES:
        if rel.startswith(prefix):
            return g
    return "other"


def find_class_header(directory, cls):
    """Return the header in 'directory' declaring 'class cls'."""
    pat = re.compile(r"^\s*class\s+" + re.escape(cls) + r"\b\s*(?::|$|\n)", re.M)
    same = directory / (cls + ".H")
    if same.is_file():
        return same
    for h in sorted(directory.glob("*.H")):
        if pat.search(read_text(h)):
            return h
    return None


def scan_registrations(root):
    """Return {header: {"cls", "names", "template"}} of registered fv::options."""
    found = {}
    for d in ("src", "applications", "modules"):
        if not (root / d).is_dir():
            continue
        for f in (root / d).rglob("*"):
            if f.suffix not in (".C", ".cxx") or not f.is_file():
                continue
            rel_parts = f.relative_to(root).parts
            if SKIP_DIRS.intersection(rel_parts):
                continue
            if any(p in rel_parts for p in FA_PATH_PARTS):
                continue
            if rel_parts[:2] == ("applications", "test"):
                continue
            text = read_text(f)
            if "option" not in text:
                continue
            for m in REGISTER_RE.finditer(strip_comments(text)):
                cls = m.group(1).split("::")[-1]
                h = find_class_header(f.parent, cls)
                if h is None:
                    continue
                names = TYPENAME_RE.findall(read_text(h))
                found[h] = {"cls": cls, "names": [names[0] if names else cls],
                            "template": False}
            for m in MAKEFV_RE.finditer(strip_comments(text)):
                cls, typ = m.group(1), m.group(2)
                h = find_class_header(f.parent, cls)
                if h is None:
                    continue
                e = found.setdefault(h, {"cls": cls, "names": [], "template": True})
                name = typ + cls
                if name not in e["names"]:
                    e["names"].append(name)
    for e in found.values():
        if e["template"]:
            e["names"].sort(key=lambda n: next(
                (i for i, t in enumerate(TEMPLATE_TYPES) if n.startswith(t)), 99))
    return found


def scan_tutorials(root, name_to_key):
    """Map entry key -> list of tutorial fvOptions files using it."""
    out = {}
    tut = root / "tutorials"
    if not tut.is_dir():
        return out
    for f in sorted(tut.rglob("fvOptions*")):
        if not f.is_file():
            continue
        if f.stat().st_size > 400000:
            continue
        rel = str(f.relative_to(root))
        for _, t in top_level_types(read_text(f)):
            key = name_to_key.get(t)
            if key:
                lst = out.setdefault(key, [])
                if rel not in lst:
                    lst.append(rel)
    return out


def build_header_index(root):
    """Map header basename -> relative path (first occurrence under src)."""
    idx = {}
    for f in (root / "src").rglob("*.H"):
        if SKIP_DIRS.intersection(f.relative_to(root).parts):
            continue
        idx.setdefault(f.name, str(f.relative_to(root)))
    return idx


def cmd_build(args):
    root = project_dir(args.src)
    print(f"Scanning {root} ...")

    regs = scan_registrations(root)
    entries = {}
    for h, r in sorted(regs.items()):
        rel = str(h.relative_to(root))
        info = parse_header(h)
        key = r["cls"] if r["template"] else r["names"][0]
        tnames = [r["cls"]] if r["template"] else r["names"]
        example = pick_example(info["verbatims"], tnames)
        lib = lib_from_make(h)
        libs = []
        lm = LIBS_RE.search(example)
        if lm:
            libs = [x.strip().strip('"') for x in lm.group(1).split()]
        elif lib and lib not in DEFAULT_LIBS:
            libs = [lib]
        # Base classes: documented links plus the actual C++ inheritance
        inherited = list(info["inherited"])
        for b in BASECLASS_RE.findall(info["text"]):
            hb = {"option": "fvOption.H"}.get(b, b + ".H")
            if hb not in inherited:
                inherited.append(hb)
        desc = info["description"]
        summary = desc.split("\n\n")[0].replace("\n", " ").strip()
        e = {
            "name": key,
            "display": ("<Type>" + r["cls"]) if r["template"] else key,
            "class": r["cls"],
            "template": r["template"],
            "variants": r["names"] if r["template"] else [],
            "group": guess_group(rel),
            "header": rel,
            "library": lib if lib is not None else "",
            "libs": libs,
            "summary": summary,
            "description": desc,
            "example": example,
            "otherExamples": [v for v in info["verbatims"] if v != example][:4],
            "tables": info["tables"],
            "inherited": inherited,
            "cellSet": "cellSetOption.H" in inherited,
            "interRegion": "interRegionOption.H" in inherited
                           or "interRegionHeatTransferModel.H" in inherited,
            "note": info["note"],
            "seeAlso": info["seeAlso"],
            "aliases": ALIASES.get(key, ""),
        }
        entries[key] = e

    name_to_key = {}
    for k, e in entries.items():
        name_to_key[k] = k
        for v in e["variants"]:
            name_to_key[v] = k
    tutorials = scan_tutorials(root, name_to_key)
    for k, e in entries.items():
        e["tutorials"] = tutorials.get(k, [])

    # Base headers documenting inherited entries
    hidx = build_header_index(root)
    wanted = list(dict.fromkeys(
        [Path(b).name for b in BASE_HEADERS] +
        [i for e in entries.values() for i in e["inherited"]]))
    bases = {}
    while wanted:
        name = wanted.pop(0)
        if name in bases:
            continue
        rel = next((b for b in BASE_HEADERS if Path(b).name == name), None) or hidx.get(name)
        if not rel or not (root / rel).is_file():
            continue
        info = parse_header(root / rel)
        parents = []
        for b in BASECLASS_RE.findall(info["text"]):
            hb = {"option": "fvOption.H"}.get(b, b + ".H")
            if hb != name and hb not in parents:
                parents.append(hb)
                wanted.append(hb)
        bases[name] = {
            "header": rel,
            "inherited": parents,
            "summary": info["description"].split("\n\n")[0].replace("\n", " "),
            "example": pick_example(info["verbatims"], []),
            "tables": info["tables"],
        }

    # Propagate base-class chains (e.g. interRegionHeatTransferModel ->
    # interRegionOption) to the entries
    for e in entries.values():
        todo = list(e["inherited"])
        while todo:
            b = todo.pop(0)
            for pb in bases.get(b, {}).get("inherited", []):
                if pb not in e["inherited"]:
                    e["inherited"].append(pb)
                    todo.append(pb)
        e["cellSet"] = "cellSetOption.H" in e["inherited"]
        e["interRegion"] = "interRegionOption.H" in e["inherited"]

    db = {
        "tool": "foamFV",
        "version": root.name,
        "built": date.today().isoformat(),
        "fvOptions": dict(sorted(entries.items(), key=lambda kv: kv[0].lower())),
        "bases": bases,
    }
    out = Path(args.output) if args.output else user_db_path(root.name)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(db, indent=1, ensure_ascii=False), encoding="utf-8")

    es = list(entries.values())
    noex = sorted(e["name"] for e in es if not e["example"])
    notab = sorted(e["name"] for e in es if not e["tables"])
    print(f"Wrote {out}")
    if not args.output and current_version() != root.name:
        print(f"  note: used automatically when $WM_PROJECT_DIR ends with '{root.name}';"
              f" otherwise set FOAMFV_DB={out}")
    print(f"  fvOptions (classes): {len(es)}")
    print(f"  selectable types   : {sum(len(e['variants']) or 1 for e in es)}")
    print(f"  with example       : {len(es) - len(noex)}")
    print(f"  with param table   : {len(es) - len(notab)}")
    print(f"  used in tutorials  : {sum(1 for e in es if e['tutorials'])}")
    print(f"  base classes       : {len(bases)}")
    if args.verbose:
        print("  no example    :", " ".join(noex) or "-")
        print("  no param table:", " ".join(notab) or "-")


