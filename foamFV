def is_foam_root(path):
    return path is not None and Path(path, "src", "OpenFOAM").is_dir()


def project_dir(arg=None, required=True):
    """Return the OpenFOAM source root directory (or None if not found).

    Search order: explicit argument, $WM_PROJECT_DIR, two levels above this
    script (when installed inside an OpenFOAM tree, e.g. <root>/myTools/foamFV).
    """
    if arg:
        cands = [Path(arg)]
    else:
        cands = []
        env = os.environ.get("WM_PROJECT_DIR")
        if env:
            cands.append(Path(env))
        cands.append(TOOL_DIR.parent.parent)
    for c_ in cands:
        if is_foam_root(c_):
            return c_.resolve()
    if required:
        sys.exit("Error: OpenFOAM source tree not found. Source the OpenFOAM "
                 "environment (etc/bashrc) or use --src <OpenFOAM root>.")
    return None


def user_db_path(version):
    base = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
    return Path(base) / "foamFV" / f"fvDatabase-{version}.json"


def current_version():
    env = os.environ.get("WM_PROJECT_DIR")
